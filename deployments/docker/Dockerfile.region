# Region Service Dockerfile
# Multi-stage build for minimal image size

FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk --no-cache add ca-certificates tzdata

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /region ./cmd/region

# ---
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /region .
COPY configs/region.yaml ./configs/

# Create data directories
RUN mkdir -p /data/storage /data/metadata /data/temp

# Default environment overrides
ENV JzSE_STORAGE_PATH=/data/storage
ENV JzSE_STORAGE_TEMP_PATH=/data/temp
ENV JzSE_METADATA_DB_PATH=/data/metadata

EXPOSE 8080 9090

ENTRYPOINT ["./region", "--config", "configs/region.yaml"]
