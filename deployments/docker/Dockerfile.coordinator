# Coordinator Service Dockerfile
# Multi-stage build for minimal image size

FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk --no-cache add ca-certificates tzdata

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /coordinator ./cmd/coordinator

# ---
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /coordinator .
COPY configs/coordinator.yaml ./configs/

EXPOSE 8081 9091

ENTRYPOINT ["./coordinator", "--config", "configs/coordinator.yaml"]
